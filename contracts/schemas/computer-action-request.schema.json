{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComputerActionRequest",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "coordinate": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "duration": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "region": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 4,
      "minItems": 4
    },
    "scroll_amount": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "scroll_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_coordinate": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
