{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComputerActionRequest",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/ComputerAction"
    },
    "coordinate": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "duration": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "region": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 4,
      "minItems": 4
    },
    "scroll_amount": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "scroll_direction": {
      "anyOf": [
        {
          "$ref": "#/definitions/ScrollDirection"
        },
        {
          "type": "null"
        }
      ]
    },
    "start_coordinate": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "ComputerAction": {
      "type": "string",
      "enum": [
        "screenshot",
        "cursor_position",
        "mouse_move",
        "left_click",
        "right_click",
        "middle_click",
        "double_click",
        "triple_click",
        "left_click_drag",
        "left_mouse_down",
        "left_mouse_up",
        "key",
        "type",
        "hold_key",
        "scroll",
        "wait",
        "zoom"
      ]
    },
    "ScrollDirection": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ]
    }
  }
}
