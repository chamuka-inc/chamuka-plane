{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialBinding",
  "type": "object",
  "required": [
    "created_at",
    "destination",
    "header_name",
    "id",
    "sandbox_id",
    "secret_id"
  ],
  "properties": {
    "created_at": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "header_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "header_name": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "sandbox_id": {
      "type": "string"
    },
    "secret_id": {
      "type": "string"
    }
  }
}
