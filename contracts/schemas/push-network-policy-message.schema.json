{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PushNetworkPolicyMessage",
  "type": "object",
  "required": [
    "backend_id",
    "policy",
    "version"
  ],
  "properties": {
    "backend_id": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/definitions/NetworkPolicy"
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "NetworkPolicy": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "$ref": "#/definitions/NetworkPolicyMode"
        },
        "rules": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/NetworkRule"
          }
        }
      }
    },
    "NetworkPolicyMode": {
      "type": "string",
      "enum": [
        "allow-all",
        "deny-all",
        "rules"
      ]
    },
    "NetworkRule": {
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/definitions/RuleAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "cidrs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "inject": {
          "type": [
            "string",
            "null"
          ]
        },
        "ports": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0.0
          }
        }
      }
    },
    "RuleAction": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    }
  }
}
