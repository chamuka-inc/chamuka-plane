{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snapshot",
  "type": "object",
  "required": [
    "arch",
    "base_image",
    "created_at",
    "digest",
    "expires_at",
    "id",
    "image_ref",
    "runtime",
    "size_bytes",
    "tenant"
  ],
  "properties": {
    "arch": {
      "$ref": "#/definitions/Arch"
    },
    "base_image": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string"
    },
    "image_ref": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": "string"
    },
    "sandbox_id": {
      "description": "Origin sandbox id. Null if the originating sandbox has been deleted — snapshots are durable artifacts (their own retention TTL via `expires_at`) and survive sandbox/backend cleanup.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "size_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "tags": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tenant": {
      "type": "string"
    }
  },
  "definitions": {
    "Arch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    }
  }
}
