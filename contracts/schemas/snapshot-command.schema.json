{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnapshotCommand",
  "type": "object",
  "required": [
    "action_id",
    "backend_id"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "backend_id": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "ttl_days": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  }
}
