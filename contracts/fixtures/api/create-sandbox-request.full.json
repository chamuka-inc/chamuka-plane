{
  "runtime": "python313",
  "image": "registry.internal/python:3.13-sandbox",
  "trust": "paranoid",
  "arch": "arm64",
  "resources": { "vcpus": 4, "memory_mb": 2048 },
  "timeout_ms": 300000,
  "source": { "type": "git", "repo": "https://github.com/acme/ml-worker.git", "branch": "main" },
  "ports": [8080, 9090],
  "env": { "PYTHON_ENV": "production", "LOG_LEVEL": "info" },
  "tags": { "team": "ml-infra", "cost-center": "eng-42" },
  "persistent": true,
  "initial_network_policy": {
    "mode": "rules",
    "rules": [{ "domains": ["api.openai.com"], "ports": [443], "action": "allow" }]
  },
  "use_static_token": true,
  "key": "ml-worker-prod"
}
