FROM rust:1.80-bookworm AS builder

WORKDIR /build
COPY crates/ crates/
COPY contracts/ contracts/

WORKDIR /build/crates
ENV SQLX_OFFLINE=true
RUN cargo build --release -p agentd

FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sandbox || true

WORKDIR /workspace

COPY --from=builder /build/crates/target/release/agentd /usr/local/bin/agentd

ENTRYPOINT ["tini", "--"]
CMD ["agentd"]

EXPOSE 8080
