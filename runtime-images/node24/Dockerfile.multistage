FROM rust:1.88-bookworm AS builder

WORKDIR /build
COPY crates/ crates/

WORKDIR /build/crates
ENV SQLX_OFFLINE=true
RUN cargo build --release --locked -p agentd --bins

FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    ca-certificates \
    iptables \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sandbox || true

WORKDIR /workspace

COPY --from=builder /build/crates/target/release/agentd /usr/local/bin/agentd
COPY --from=builder /build/crates/target/release/sandbox-init /usr/local/bin/sandbox-init

ENTRYPOINT ["tini", "--", "sandbox-init"]
CMD ["agentd"]

EXPOSE 8080
