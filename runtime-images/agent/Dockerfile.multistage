FROM rust:1.88-bookworm AS builder

COPY crates/ /build/crates/
WORKDIR /build/crates

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/crates/target \
    SQLX_OFFLINE=true cargo build --release --locked -p agentd --bins \
    && cp target/release/agentd /agentd \
    && cp target/release/sandbox-init /sandbox-init

FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    ca-certificates \
    curl \
    iptables \
    wget \
    jq \
    git \
    less \
    procps \
    file \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sandbox || true

WORKDIR /workspace

COPY --from=builder /agentd /usr/local/bin/agentd
COPY --from=builder /sandbox-init /usr/local/bin/sandbox-init

ENTRYPOINT ["tini", "--", "sandbox-init", "agentd"]

EXPOSE 8080
