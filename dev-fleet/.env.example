# Copy to .env and edit. All values are optional; defaults shown.

# ---- Fleet size and resources ----
# DRONE_COUNT=3
# DRONE_VCPUS=2
# DRONE_MEM_MB=4096

# ---- Trust tiers ----
# Comma-separated, cycled through drones in order.
# Examples:
#   TRUST_TIERS=trusted,untrusted     (default)
#   TRUST_TIERS=untrusted             (all drones run gVisor)
#   TRUST_TIERS=trusted               (all drones run runc; faster, less isolated)
# TRUST_TIERS=trusted,untrusted

# ---- Nested virtualization ----
# Required if you plan to add Kata + Firecracker drones later.
# NESTED_VIRT=on

# ---- Network ----
# Host-only network IP that VMs and host services share.
# Vagrant will create the 192.168.56.0/24 network if it doesn't exist.
# HOST_BIND_IP=192.168.56.1
# CONTROLLER_HOST=192.168.56.1
# CONTROLLER_PORT=8080
# PROXY_PORT=9090

# Cluster name as Plane sees it. Includes the proxy port so Plane treats
# it as a dev cluster (no HTTPS / ACME).
# CLUSTER_NAME=192.168.56.1:9090
