# Controller public API (reachable from BFF)
CONTROLLER_URL=http://localhost:8080

# Controller internal API (for /ctrl/* routes, operator-only)
CONTROLLER_INTERNAL_URL=http://localhost:8080

# WebSocket relay server port (terminal connections)
WS_RELAY_PORT=3101

# Default cluster name (for fleet queries)
DEFAULT_CLUSTER=iad-x86-default

# Auth headers injected by BFF (in production, the front-door reverse proxy injects these)
AUTH_TENANT=tenant-default
AUTH_USER=admin
